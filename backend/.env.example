# Copy this file to `.env.local` (NOT `.env`) — server.js and config/db.js
# both load `.env.local` explicitly.
#
#   cp .env.example .env.local

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=financeanalytics

# Server
PORT=3001
NODE_ENV=development

# JWT — generate a strong random value, do not ship the placeholder:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Google OAuth (optional — only needed for Google sign-in)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# AI Providers
# AI_PROVIDER selects the default; users can override per request.
# Statement parsing fails without a key for the selected provider.
AI_PROVIDER=gemini
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Email / OTP (required for OTP login and password reset)
# Without SENDGRID_API_KEY the app returns "Email service is not configured".
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=admin@finlytix.in

# Payments (required for the pricing page and premium features)
# Without these, /api/payments/create-order returns a configuration error.
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Frontend URL — used as the CORS origin, must match where the frontend runs
FRONTEND_URL=http://localhost:3000
