# Copy this file to `.env.local`:
#
#   cp .env.example .env.local
#
# Every value here is optional for local development — the defaults below are
# what the code falls back to.

# Backend API origin. Defaults to http://localhost:3001 when unset.
# Must be set for any deployment where the backend is not on localhost:3001.
NEXT_PUBLIC_API_URL=http://localhost:3001
